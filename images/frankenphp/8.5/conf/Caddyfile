#
# Magento / Mage-OS on FrankenPHP (classic mode)
#
# TLS is terminated by nginx-proxy, this server only speaks plain HTTP on :8080.
# Translated from images/nginx/default.conf + images/nginx/magento.conf.
#
{
	frankenphp
	auto_https off
	admin off

	servers {
		# nginx-proxy forwards X-Forwarded-* from the docker networks
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /var/www/src/pub

	encode zstd gzip

	request_body {
		max_size 4GB
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Basic auth, same idea as the commented block in images/nginx/default.conf
	#basic_auth {
	#	admin <bcrypt hash from: frankenphp hash-password>
	#}

	@denied {
		path /media/customer/* /media/downloadable/* /media/import/* /media/custom_options/*
		path /media/theme_customization/*.xml /errors/*.xml
		path *.phtml *.htaccess *.htpasswd *.user.ini
	}

	# Hidden files and folders (.git, .env, ...), except .well-known
	@hidden {
		path_regexp /\.
		not path /.well-known/*
	}

	# Only Magento's entry points may be executed
	@phpDenied {
		path *.php
		not path /index.php /get.php /static.php /health_check.php /errors/*.php
	}

	@staticVersion path_regexp staticVersion ^/static/version\d+/(.*)$

	@staticMissing {
		path_regexp staticPath ^/static/(.*)$
		not file
	}

	@mediaMissing {
		path /media/*
		not file
	}

	@cacheForever {
		path /static/* /media/*
		path_regexp \.(ico|jpg|jpeg|png|gif|svg|svgz|webp|avif|avifs|js|css|eot|ttf|otf|woff|woff2|html|json|webmanifest)$
	}

	@noStore {
		path /static/* /media/*
		path_regexp \.(zip|gz|gzip|bz2|csv|xml)$
	}

	route {
		# Some setups link to /pub/..., the document root already is pub/
		uri strip_prefix /pub

		respond @denied 403
		respond @hidden 403

		header @cacheForever Cache-Control "public, max-age=31536000"
		header @noStore Cache-Control "no-store"

		rewrite @staticVersion /static/{re.staticVersion.1}
		rewrite @staticMissing /static.php?resource={re.staticPath.1}
		rewrite @mediaMissing /get.php?{query}

		respond @phpDenied 403

		php_server
	}

	#log {
	#	output stdout
	#}
}
