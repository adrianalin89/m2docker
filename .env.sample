PROJECT_NAME=bar

USER_ID=1000
GROUP_ID=1000
DOMAIN_HOSTS={{project_name}}.test
DOMAIN_EMAIL=admin@{{project_name}}.test
PHP_VERSION=8.3
# nginx (nginx + php-fpm from images/php/$PHP_VERSION) or frankenphp (images/frankenphp/8.5)
WEB_SERVER=nginx

# Docker log rotation for this project's containers
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

COMPOSER_DISABLE_XDEBUG_WARN=1
PHP_CS_FIXER_IGNORE_ENV=1
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

MYSQL_HOST={{project_name}}-db
MYSQL_DATABASE={{project_name}}
MYSQL_USER=magento
MYSQL_PASSWORD=magento
MYSQL_ROOT_PASSWORD=magento
# InnoDB buffer pool of this project's MariaDB, ex. 1G local, 4G+ on a server
DB_BUFFER_POOL_SIZE=1G

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
DISABLE_SECURITY_PLUGIN=true

REDIS_CACHE_BACKEND_SERVER={{project_name}}-redis
REDIS_CACHE_BACKEND_DB=0
REDIS_PAGE_CACHE_SERVER={{project_name}}-redis
REDIS_PAGE_CACHE_DB=1
REDIS_SESSION_SAVE_HOST={{project_name}}-redis

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER={{project_name}}
RABBITMQ_DEFAULT_PASS=magento
RABBITMQ_DEFAULT_VHOST={{project_name}}-magento

ECOMSCAN_EMAIL=alin.munteanu@roweb.com
ECOMSCAN_LICENSE_KEY=trial
ECOMSCAN_MIN_CONFIDENCE=50

# Deployment (bin/pipeline, bin/deploy, bin/deploy-releases)
# simple = git pull in src/ + maintenance mode, releases = zero downtime release folders
DEPLOY_TYPE=simple
# branch deployed on this server, empty = deploy what is checked out
DEPLOY_BRANCH=
DEPLOY_LOCALES="en_US"
DEPLOY_MAINTENANCE=1
# ex. --no-dev --optimize-autoloader (releases defaults to that when empty)
DEPLOY_COMPOSER_ARGS=
# build Hyvä Tailwind themes (npm ci + build-prod)
DEPLOY_TAILWIND=1
DEPLOY_KEEP_RELEASES=3
