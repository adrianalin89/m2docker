#!/usr/bin/env bash
# Update the boilerplate files of this project from the m2docker repository (master).
#
# Usage:
#   bin/update --dry-run   only show which files would be added, changed or removed
#   bin/update --diff      same, with the content differences of the changed files
#   bin/update             show the changes and apply them after confirmation
#   bin/update --yes       apply without asking
#
# - The {{project_name}} placeholder is replaced with PROJECT_NAME from .env in
#   the downloaded files, so the project keeps working right after the update.
# - Never touched: .env, src/, releases/, shared/, current, compose.override.yaml
#   and any file of yours that is not part of the boilerplate.
# - Files removed from the boilerplate are only deleted from bin/, lib/, images/
#   and the RETIRED list below, after a separate confirmation. A legacy
#   images/nginx/.htpasswd is never deleted (bin/setup-htpasswd moves it).
# - Put project specific compose changes in compose.override.yaml, they survive updates.

set -o errexit

REPOSITORY="${M2DOCKER_REPOSITORY:-https://github.com/adrianalin89/m2docker.git}"
BRANCH="master"
# Root files that were part of the boilerplate once and were removed from it
RETIRED=(other.yaml)
# Folders fully owned by the boilerplate (files missing upstream can be removed)
MANAGED_DIRS=(bin lib images)
EXCLUDES=(.git .env src releases shared current compose.override.yaml)

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

cd "$(dirname "$0")/.." || exit 1

MODE="apply"
ASSUME_YES=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) MODE="dry-run" ;;
    --diff) MODE="diff" ;;
    --yes|-y) ASSUME_YES=1 ;;
    -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  esac
done

confirm() {
  [ "$ASSUME_YES" -eq 1 ] && return 0
  local reply
  read -r -p "$1 [y/N] " reply < /dev/tty
  [[ "$reply" =~ ^[Yy]$ ]]
}

PROJECT_NAME=$(grep -E '^PROJECT_NAME=' .env 2>/dev/null | cut -d '=' -f2)
if [ -z "$PROJECT_NAME" ]; then
  echo -e "${RED}PROJECT_NAME is missing in .env, run this from a configured project.${NC}"
  exit 1
fi

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT
UPSTREAM="$TMP_DIR/m2docker"

echo -e "${BLUE}Downloading m2docker ($BRANCH)...${NC}"
git clone -q --depth 1 --branch "$BRANCH" "$REPOSITORY" "$UPSTREAM"
echo "  $(git -C "$UPSTREAM" log -1 --format='%h %s (%ad)' --date=short)"
rm -rf "$UPSTREAM/.git"

# Same replacement bin/setup-docker does on a new project. The placeholder is
# built from two parts so this script never replaces its own search string.
PLACEHOLDER="{{project""_name}}"
grep -rlF --exclude=setup-docker "$PLACEHOLDER" "$UPSTREAM" | while read -r file; do
  sed -i "s/$PLACEHOLDER/$PROJECT_NAME/g" "$file"
done

RSYNC_EXCLUDES=()
for exclude in "${EXCLUDES[@]}"; do
  RSYNC_EXCLUDES+=(--exclude "/$exclude")
done

# Added / changed files
NEW=()
CHANGED=()
while IFS= read -r line; do
  file="${line:12}"
  case "$line" in
    ">f+++++++++"*) NEW+=("$file") ;;
    ">f"*) CHANGED+=("$file") ;;
  esac
done < <(rsync -rc --dry-run --itemize-changes "${RSYNC_EXCLUDES[@]}" "$UPSTREAM/" ./)

# Removed upstream
REMOVED=()
for dir in "${MANAGED_DIRS[@]}"; do
  [ -d "$dir" ] || continue
  while IFS= read -r file; do
    [ -e "$UPSTREAM/$file" ] || REMOVED+=("$file")
  done < <(find "$dir" -type f ! -name .htpasswd | sort)
done
for file in "${RETIRED[@]}"; do
  [ -e "$file" ] && [ ! -e "$UPSTREAM/$file" ] && REMOVED+=("$file")
done

if [ ${#NEW[@]} -eq 0 ] && [ ${#CHANGED[@]} -eq 0 ] && [ ${#REMOVED[@]} -eq 0 ]; then
  echo -e "${GREEN}Already up to date.${NC}"
  exit 0
fi

echo ""
[ ${#NEW[@]} -gt 0 ] && echo -e "${GREEN}New (${#NEW[@]}):${NC}" && printf '  + %s\n' "${NEW[@]}"
[ ${#CHANGED[@]} -gt 0 ] && echo -e "${YELLOW}Changed (${#CHANGED[@]}):${NC}" && printf '  ~ %s\n' "${CHANGED[@]}"
[ ${#REMOVED[@]} -gt 0 ] && echo -e "${RED}Removed from the boilerplate (${#REMOVED[@]}):${NC}" && printf '  - %s\n' "${REMOVED[@]}"

if [ "$MODE" = "diff" ]; then
  for file in "${CHANGED[@]}"; do
    echo ""
    diff -u --label "a/$file" --label "b/$file" "$file" "$UPSTREAM/$file" || true
  done
fi

if [ "$MODE" != "apply" ]; then
  echo ""
  echo -e "${BLUE}Nothing changed. Run bin/update to apply (bin/update --diff to see the differences).${NC}"
  exit 0
fi

echo ""
if [ ${#NEW[@]} -gt 0 ] || [ ${#CHANGED[@]} -gt 0 ]; then
  if confirm "Apply the new and changed files?"; then
    rsync -a --checksum "${RSYNC_EXCLUDES[@]}" "$UPSTREAM/" ./
    echo -e "${GREEN}Files updated.${NC}"
  else
    echo "Skipped."
  fi
fi

if [ ${#REMOVED[@]} -gt 0 ]; then
  if confirm "Delete the ${#REMOVED[@]} file(s) removed from the boilerplate?"; then
    for file in "${REMOVED[@]}"; do
      rm -f "$file"
    done
    find "${MANAGED_DIRS[@]}" -type d -empty -delete 2>/dev/null || true
    echo -e "${GREEN}Removed files deleted.${NC}"
  else
    echo "Kept."
  fi
fi

echo ""
if printf '%s\n' "${NEW[@]}" "${CHANGED[@]}" | grep -q '^images/'; then
  echo -e "${YELLOW}Docker images changed: run bin/docker-compose build, then bin/restart.${NC}"
else
  echo -e "${YELLOW}Run bin/restart to apply the updates.${NC}"
fi
