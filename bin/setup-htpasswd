#!/usr/bin/env bash
# Turn on basic auth for the storefront (staging): writes the root file .htpasswd
# and sets HTPASSWD=on in .env, then recreates the nginx container.
#
# Usage: bin/setup-htpasswd [user] [password]     (default: roweb / roweb321)
#        bin/setup-htpasswd --off                  turn it off again (.htpasswd is kept)
#
# A project that still has the old images/nginx/.htpasswd gets it moved to the root file.

. "$(dirname "$0")/../lib/deploy.sh"
cd "$PROJECT_ROOT" || exit 1

set_env() {
  if grep -qE "^$1=" .env; then
    sed -i -E "s|^$1=.*|$1=$2|" .env
  else
    printf '\n%s=%s\n' "$1" "$2" >> .env
  fi
}

if [ "${1:-}" = "--off" ]; then
  set_env HTPASSWD off
else
  if [ -s images/nginx/.htpasswd ] && [ ! -s .htpasswd ]; then
    mv images/nginx/.htpasswd .htpasswd
    log_ok "Moved images/nginx/.htpasswd to .htpasswd"
  fi
  if [ $# -gt 0 ] || [ ! -s .htpasswd ]; then
    USER_NAME="${1:-roweb}"
    PASSWORD="${2:-roweb321}"
    printf '%s:%s\n' "$USER_NAME" "$(openssl passwd -apr1 "$PASSWORD")" > .htpasswd
    log_ok "User $USER_NAME written to .htpasswd"
  fi
  chmod 644 .htpasswd
  set_env HTPASSWD on
fi

log_ok "HTPASSWD=$(env_value HTPASSWD) in .env"
bin/docker-compose up -d --no-deps "${PROJECT_NAME}-nginx"
