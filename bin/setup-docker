#!/bin/bash
# Replace the {{project_name}} placeholder with PROJECT_NAME from .env in the
# boilerplate files only (never src/, releases/, shared/ or anything else).
ENV_FILE=".env"
# Built from two parts so the scripts never replace their own search string
SEARCH_STRING="{{project""_name}}"

# Files and folders that contain the placeholder in the boilerplate
INFRA_PATHS=(compose.yaml compose.frankenphp.yaml compose.override.yaml env.php "$ENV_FILE" Makefile README.md bin lib images scripts)

# Read the PROJECT_NAME variable from the .env file
if [ -f "$ENV_FILE" ]; then
    PROJECT_NAME=$(grep -E '^PROJECT_NAME=' "$ENV_FILE" | cut -d '=' -f2)
else
    echo "The .env file was not found!"
    exit 1
fi

# Check if PROJECT_NAME has a value
if [ -z "$PROJECT_NAME" ]; then
    echo "The PROJECT_NAME variable was not found in the .env file or is empty!"
    exit 1
fi

EXISTING=()
for path in "${INFRA_PATHS[@]}"; do
    [ -e "$path" ] && EXISTING+=("$path")
done

grep -rlF --exclude=setup-docker "$SEARCH_STRING" "${EXISTING[@]}" 2>/dev/null | while read -r file; do
    sed -i "s/$SEARCH_STRING/$PROJECT_NAME/g" "$file"
    echo "  $file"
done

echo "Replacement was successful! $PROJECT_NAME"
